# ====================================================================
# EXCUSE.AI — Environment Configuration
# ====================================================================

# 1. Neon Serverless PostgreSQL Database (Recommended)
# Copy your connection string from your Neon Console (https://console.neon.tech)
DATABASE_URL=postgresql://neondb_owner:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require

# 2. Supabase Database (Alternative)
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_KEY=your-supabase-service-role-or-anon-key

# 3. Google Gemini API (Optional — built-in contextual offline engine enabled by default)
# GOOGLE_API_KEY=your-gemini-api-key

# 4. Server Port
PORT=5000
